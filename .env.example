# Plantilla de configuracion - copiar a .env y completar valores
BROWSERBASE_URL=ws://localhost:3000

# HEADLESS: true conecta a Browserless via CDP (headless remoto);
# false lanza Chromium local visible con ventana maximizada
HEADLESS=true
VFA_LLM_PROVIDER=openai
VFA_LLM_MODEL=gpt-4o
VFA_LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VFA_VISION_PROVIDER=
VFA_VISION_MODEL=
VFA_VISION_API_KEY=
VFA_LLM_REQUESTS_PER_SECOND=0
VFA_LLM_CHECKS_PER_SECOND=10.0

# --- Pool de sesiones persistentes del navegador ---
# VFA_SESSION_POOL_ENABLED: activa sesiones persistentes entre llamadas a tools QA
# VFA_SESSION_POOL_TTL: segundos de inactividad antes de cerrar una sesion
# VFA_SESSION_POOL_MAX_SIZE: maximo de sesiones simultaneas (eviccion LRU)
VFA_SESSION_POOL_ENABLED=true
VFA_SESSION_POOL_TTL=300
VFA_SESSION_POOL_MAX_SIZE=5
